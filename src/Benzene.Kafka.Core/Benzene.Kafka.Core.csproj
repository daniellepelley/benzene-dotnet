<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Benzene.Kafka.Core</AssemblyName>
    <RootNamespace>Benzene.Kafka.Core</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Benzene.Clients\Benzene.Clients.csproj" />
    <ProjectReference Include="..\Benzene.Core\Benzene.Core.csproj" />
    <ProjectReference Include="..\Benzene.HostedService\Benzene.HostedService.csproj" />
    <ProjectReference Include="..\Benzene.HealthChecks.Core\Benzene.HealthChecks.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- So KafkaWorkerDeadLetterAndDrainTest can invoke BenzeneKafkaWorker's OnPartitionsRevoked/
         OnPartitionsLost rebalance-callback methods directly (mocked IConsumer, real
         TopicPartitionOffset lists) instead of only indirectly through ConsumerBuilder - whose
         registered Func/Action handler delegates are stored on non-public properties, so there is no
         way to read them back and invoke them without a live broker connection. -->
    <InternalsVisibleTo Include="Benzene.Test" />
  </ItemGroup>

</Project>
