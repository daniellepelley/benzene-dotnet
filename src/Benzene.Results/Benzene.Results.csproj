<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Benzene.Results</AssemblyName>
    <RootNamespace>Benzene.Results</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Benzene.Abstractions\Benzene.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Benzene.Clients.Common.ClientResultExtensions attaches a received ProblemDetails document to
         a result under the envelope/HTTP-classified status (not one re-derived from the document's
         own BenzeneStatus) via the internal AttachReceivedProblem seam - see BenzeneResult.cs. -->
    <InternalsVisibleTo Include="Benzene.Clients" />
  </ItemGroup>

</Project>
