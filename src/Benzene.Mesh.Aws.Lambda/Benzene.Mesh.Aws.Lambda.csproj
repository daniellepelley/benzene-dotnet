<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Benzene.Mesh.Aws.Lambda</AssemblyName>
    <RootNamespace>Benzene.Mesh.Aws.Lambda</RootNamespace>
    <Description>AWS Lambda bindings for the Benzene Mesh aggregator: an IMeshServiceSource (AddMeshLambdaSource) that interrogates a service's spec/health by Invoke instead of HTTP, and an IMeshServiceDispatcher (AddMeshLambdaDispatcher) that dispatches a mesh:dispatch payload the same way.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Benzene.Mesh.Aggregator\Benzene.Mesh.Aggregator.csproj" />
    <ProjectReference Include="..\Benzene.Clients.Aws\Benzene.Clients.Aws.csproj" />
    <ProjectReference Include="..\Benzene.Mesh.Dispatch\Benzene.Mesh.Dispatch.csproj" />
  </ItemGroup>

</Project>
