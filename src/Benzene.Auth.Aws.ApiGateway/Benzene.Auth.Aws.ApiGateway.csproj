<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Benzene.Auth.Aws.ApiGateway</AssemblyName>
    <RootNamespace>Benzene.Auth.Aws.ApiGateway</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Caller identity from an AWS API Gateway authorizer for Benzene (UseApiGatewayAuthorizerIdentity): turns the event's Cognito, JWT, Lambda or IAM authorizer context into the caller's ClaimsPrincipal, so RequireScope/RequireRole/RequirePolicy work without validating the token again in the function.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Benzene.Auth.Core\Benzene.Auth.Core.csproj" />
    <ProjectReference Include="..\Benzene.Aws.Lambda.ApiGateway\Benzene.Aws.Lambda.ApiGateway.csproj" />
    <ProjectReference Include="..\Benzene.Core.Middleware\Benzene.Core.Middleware.csproj" />
  </ItemGroup>

</Project>
