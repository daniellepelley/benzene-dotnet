<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Benzene.Mesh.Usage.ApplicationInsights</AssemblyName>
    <RootNamespace>Benzene.Mesh.Usage.ApplicationInsights</RootNamespace>
    <Description>An IMeshUsageSource for the Benzene Mesh aggregator backed by Azure Monitor / Application Insights (queried via Azure.Monitor.Query): reads per-topic request counts over a window back into usage.json, the Azure analogue of Benzene.Mesh.Usage.CloudWatch. Adds AddApplicationInsightsUsage.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Monitor.Query" Version="1.6.0" />
    <PackageReference Include="Azure.Identity" Version="1.13.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Benzene.Abstractions\Benzene.Abstractions.csproj" />
    <ProjectReference Include="..\Benzene.Mesh.Contracts\Benzene.Mesh.Contracts.csproj" />
  </ItemGroup>

  <!-- Lets the test project unit-test LogsQueryUsageQuery's KQL-escaping helper directly, without having
       to mock Azure.Monitor.Query's Response<LogsQueryResult> (an SDK-internal type not designed to be
       constructed from outside the SDK) just to observe the generated query string. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Benzene.Mesh.Test" />
  </ItemGroup>

</Project>
