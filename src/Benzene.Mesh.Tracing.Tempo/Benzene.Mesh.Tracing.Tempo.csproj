<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Benzene.Mesh.Tracing.Tempo</AssemblyName>
    <RootNamespace>Benzene.Mesh.Tracing.Tempo</RootNamespace>
    <Description>Builds the mesh aggregator's topology.json service-graph edges from Grafana Tempo's metrics-generator, queried via its Prometheus-compatible API - distinct from Benzene.Mesh.Fleet.Tempo (the live Fleet view's IMeshTraceSource). Adds AddTempoTopology.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Benzene.Mesh.Contracts\Benzene.Mesh.Contracts.csproj" />
    <ProjectReference Include="..\Benzene.Mesh.Aggregator\Benzene.Mesh.Aggregator.csproj" />
    <ProjectReference Include="..\Benzene.Abstractions.MessageHandlers\Benzene.Abstractions.MessageHandlers.csproj" />
    <ProjectReference Include="..\Benzene.Core.MessageHandlers\Benzene.Core.MessageHandlers.csproj" />
    <ProjectReference Include="..\Benzene.Http\Benzene.Http.csproj" />
  </ItemGroup>

</Project>
