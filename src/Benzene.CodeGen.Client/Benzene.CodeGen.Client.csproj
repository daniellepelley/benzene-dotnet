<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Benzene.CodeGen.Client</AssemblyName>
    <RootNamespace>Benzene.CodeGen.Client</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Benzene.Abstractions.Pipelines\Benzene.Abstractions.Pipelines.csproj" />
    <ProjectReference Include="..\Benzene.CodeGen.Core\Benzene.CodeGen.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- TopicScope and SchemaClosure are internal (see their own doc comments); the conformance
         runner exercises them directly against the language-neutral fixtures rather than through
         Benzene.Test's golden-file/behavioural tests. -->
    <InternalsVisibleTo Include="Benzene.Conformance.Test" />
  </ItemGroup>

</Project>
