<Project>
  <!--
    Build integration for benzene-descriptor. Emits <service>.spec.json and <service>.service.json
    into the output folder after every build, by running the tool against the just-built assembly
    (which runs in the service's own output folder, so its full dependency closure is present).

    Opt in per project:
        <PropertyGroup>
          <BenzeneEmitDescriptor>true</BenzeneEmitDescriptor>
        </PropertyGroup>

    Assumes the `benzene-descriptor` tool is on PATH (a global tool, or a local tool restored via a
    .config/dotnet-tools.json manifest). Override BenzeneDescriptorCommand to invoke it another way
    (e.g. `dotnet tool run benzene-descriptor`).

    A failing emit fails the build (no ContinueOnError) — that is the point: a service that can't
    produce its own contract artifact should not report a green build. That now includes a service
    version that does not parse under its declared ordering scheme (mesh.md section 2.5): the build
    that declares a version is the cheapest place in the system to catch it, and after that point the
    value travels into a comparison somebody decides a deployment from.
  -->
  <PropertyGroup>
    <BenzeneEmitDescriptor Condition="'$(BenzeneEmitDescriptor)' == ''">false</BenzeneEmitDescriptor>
    <BenzeneDescriptorCommand Condition="'$(BenzeneDescriptorCommand)' == ''">benzene-descriptor</BenzeneDescriptorCommand>
    <BenzeneDescriptorEmit Condition="'$(BenzeneDescriptorEmit)' == ''">both</BenzeneDescriptorEmit>
    <BenzeneDescriptorServiceName Condition="'$(BenzeneDescriptorServiceName)' == ''">$(AssemblyName)</BenzeneDescriptorServiceName>
    <!-- How this project's service version is ordered (mesh.md section 2.5). Defaults to semver
         because the value forwarded below is MSBuild's Version property, which is semver by
         definition - it is the NuGet package version. Override it when your pipeline stamps Version
         with something else:
             integer        a bare build counter
             lexicographic  a sortable string such as a timestamp
         Set it to an empty value to declare no version at all, which is section 2.4 case 3: the
         service then has exactly one service version, and that is not an error.
         There is deliberately no default in the SPEC - this default belongs to this integration,
         which knows what it is forwarding. -->
    <BenzeneDescriptorVersionScheme Condition="'$(BenzeneDescriptorVersionScheme)' == ''">semver</BenzeneDescriptorVersionScheme>
  </PropertyGroup>

  <Target Name="BenzeneEmitDescriptor"
          AfterTargets="Build"
          Condition="'$(BenzeneEmitDescriptor)' == 'true'">
    <!-- The BenzeneDescriptorOutput default is computed here, inside the Target, not in the
         top-level PropertyGroup above. $(TargetDir) is set by the SDK's own build targets
         (Microsoft.Common.CurrentVersion.targets, imported implicitly AFTER this file's content
         when a consuming project does <Import Project="...Benzene.Descriptor.targets" /> from its
         own body, the normal way to import a targets file). A top-level PropertyGroup referencing
         $(TargetDir) would evaluate before that import runs, capture an empty value, and silently
         write the descriptor into the project's source directory instead of its build output. A
         PropertyGroup nested inside a Target is instead evaluated at execution time, once every
         import has already been fully evaluated, so $(TargetDir) is resolved correctly by then. -->
    <PropertyGroup>
      <!-- The descriptor path when BenzeneDescriptorEmit is "both" (the default) or "descriptor"; the
           spec path is derived from it (.service.json to .spec.json) unless BenzeneDescriptorEmit is
           "spec", in which case this IS the spec path. -->
      <BenzeneDescriptorOutput Condition="'$(BenzeneDescriptorOutput)' == ''">$(TargetDir)$(AssemblyName).service.json</BenzeneDescriptorOutput>
      <!-- Version is read HERE, inside the Target, for exactly the reason spelled out above for
           TargetDir: the SDK sets it in targets imported after this file's body, so a top-level
           PropertyGroup captures an empty string. It did, and the emit had been passing an empty
           service-version on every build since this integration shipped - silently, because an
           absent version is legitimate (mesh.md section 2.4 case 3) and looks like nothing is wrong.
           Both flags travel together or neither does: a version with no scheme is rejected by the
           tool (section 2.5 has no default), and a scheme with no version orders nothing. -->
      <BenzeneDescriptorVersionArg Condition="'$(BenzeneDescriptorVersionScheme)' != '' AND '$(Version)' != ''">--service-version &quot;$(Version)&quot; --version-scheme &quot;$(BenzeneDescriptorVersionScheme)&quot;</BenzeneDescriptorVersionArg>
    </PropertyGroup>
    <!-- BenzeneDescriptorCommand is NOT quoted as a single token: it must also support a multi-word
         invocation (for example running the tool via "dotnet tool run", or building and running it
         from source with a "dotnet run" form when it isn't installed on PATH) — quoting it as one
         token would make a shell look for a single literal executable named after the whole phrase. -->
    <Exec Command="$(BenzeneDescriptorCommand) --assembly &quot;$(TargetPath)&quot; --output &quot;$(BenzeneDescriptorOutput)&quot; --emit &quot;$(BenzeneDescriptorEmit)&quot; --service &quot;$(BenzeneDescriptorServiceName)&quot; $(BenzeneDescriptorVersionArg) $(BenzeneDescriptorStartupArg)" />
  </Target>

  <!-- Set BenzeneDescriptorStartup (a full BenzeneStartUp type name) when the service assembly
       defines more than one candidate; forwarded to the CLI's startup-selection flag below.
       (Note: literal double-hyphens can't appear in an XML comment, hence the paraphrase.) -->
  <PropertyGroup Condition="'$(BenzeneDescriptorStartup)' != ''">
    <BenzeneDescriptorStartupArg>--startup &quot;$(BenzeneDescriptorStartup)&quot;</BenzeneDescriptorStartupArg>
  </PropertyGroup>
</Project>
