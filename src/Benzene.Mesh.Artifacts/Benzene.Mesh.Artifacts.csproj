<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Benzene.Mesh.Artifacts</AssemblyName>
    <RootNamespace>Benzene.Mesh.Artifacts</RootNamespace>
    <Description>Serves a Benzene.Mesh.Aggregator's generated catalog artifacts (manifest.json, topology.json, services/*.json, usage.json, annotations.json, asyncapi.json) over HTTP from any registered IMeshArtifactStore, so the Mesh UI has something to load regardless of which store backs it.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Benzene.Mesh.Aggregator\Benzene.Mesh.Aggregator.csproj" />
    <ProjectReference Include="..\Benzene.Http\Benzene.Http.csproj" />
  </ItemGroup>

</Project>
