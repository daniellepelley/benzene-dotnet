    <ProjectReference Include="..\..\..\src\Benzene.Mesh.Collector\Benzene.Mesh.Collector.csproj" />
    <ProjectReference Include="..\..\..\src\Benzene.Mesh.Dispatch\Benzene.Mesh.Dispatch.csproj" />
    <ProjectReference Include="..\..\..\src\Benzene.Mesh.Fleet.Aws.XRay\Benzene.Mesh.Fleet.Aws.XRay.csproj" />
