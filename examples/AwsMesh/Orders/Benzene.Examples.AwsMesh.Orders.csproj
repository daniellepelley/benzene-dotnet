<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <AssemblyName>Benzene.Examples.AwsMesh.Orders</AssemblyName>
    <RootNamespace>Benzene.Examples.AwsMesh.Orders</RootNamespace>
    <!-- .NET 10 has no managed Lambda runtime; deploy self-contained on provided.al2023. -->
    <AWSProjectType>Lambda</AWSProjectType>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <!-- provided.al2023 ships no libicu; run globalization-invariant so the apphost starts. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- This project used to dogfood the PUBLISHED `benzene` CLI (NuGet, pinned in
       .config/dotnet-tools.json) via <BenzeneCliCommand>dotnet tool run benzene</BenzeneCliCommand>,
       rather than the from-source `dotnet run` form examples/Directory.Build.props defaults to - the
       one example exercising the real consumer experience end to end. It is temporarily back on the
       from-source form: the last published CLI (0.0.2-alpha.6) still generates a client that
       implements IHasHealthCheck and lists benzene:healthcheck in its RequiredTopics, which is
       precisely the defect this example exists to prove is gone (that entry made the outbound-routing
       start-up check fail the host). Restore the two lines above once a CLI version carrying the fix
       is published and pinned - the packaged-tool path is worth covering. Until then the published
       tool would silently reinstate the bug here. -->

  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.RuntimeSupport" Version="1.10.0" />
    <PackageReference Include="Amazon.Lambda.Core" Version="2.2.0" />
    <!-- Targets-only package (auto-imports its build\*.targets): generates the payments client below
         before CoreCompile. PrivateAssets - build-time only, must not flow to referencing projects. -->
    <PackageReference Include="Benzene.CodeGen.Build" Version="0.0.2-alpha.6" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- orders-api consumes exactly ONE topic of payments-api, so it generates a client for that topic
         and nothing else - the coupling surface is the one call it actually makes. Replaces the
         hand-written OutboundPaymentCapture mirror DTO that used to duplicate payments-api's request
         shape and topic id by hand, with no way to notice when the two drifted.
         contracts/payments.spec.json is payments-api's own contract, committed here the way a consumer
         team commits a copy of a producer's (payments-api emits it on every build - see
         docs/contract-artifacts.md). -->
    <BenzeneServiceContract Include="contracts\payments.spec.json"
                             Mode="topic-client"
                             ServiceName="Payments"
                             Namespace="Benzene.Examples.AwsMesh.Orders.Clients"
                             Topics="payments:capture" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the ADOT collector config into the Lambda zip (published to /var/task/collector.yaml),
         selected via OPENTELEMETRY_COLLECTOR_CONFIG_URI so the collector forwards traces to X-Ray. -->
    <Content Include="..\collector.yaml" Link="collector.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Benzene.Examples.AwsMesh.Shared.csproj" />
    <ProjectReference Include="..\..\..\src\Benzene.Aws.Lambda.Core\Benzene.Aws.Lambda.Core.csproj" />
    <ProjectReference Include="..\..\..\src\Benzene.Aws.Lambda.ApiGateway\Benzene.Aws.Lambda.ApiGateway.csproj" />
    <ProjectReference Include="..\..\..\src\Benzene.CloudService\Benzene.CloudService.csproj" />
    <ProjectReference Include="..\..\..\src\Benzene.Schema.OpenApi\Benzene.Schema.OpenApi.csproj" />
    <ProjectReference Include="..\..\..\src\Benzene.HealthChecks\Benzene.HealthChecks.csproj" />
    <ProjectReference Include="..\..\..\src\Benzene.Spec.Ui\Benzene.Spec.Ui.csproj" />
    <ProjectReference Include="..\..\..\src\Benzene.Microsoft.Dependencies\Benzene.Microsoft.Dependencies.csproj" />
  </ItemGroup>

</Project>
