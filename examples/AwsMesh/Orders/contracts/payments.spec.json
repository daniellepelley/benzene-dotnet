{
  "schemaDialect": "openapi-3.0",
  "service": "payments-api",
  "serviceVersion": "1.0.0",
  "messageEndpoint": "/benzene/invoke",
  "transports": [
    "api-gateway",
    "benzene",
    "sqs",
    "sns",
    "eventbridge"
  ],
  "contractHash": "sha256:7ee4bcd901e7b6bf0b50377c265d2a21f60b556261097153e52916ccb98fbe2f",
  "registrationHash": "sha256:d1620d1a19a0d501bb17e56fcb6af9ebe1ecf3b6b409fb4877786a600203dcf9",
  "requests": [
    {
      "topic": "payments:capture",
      "httpMappings": [
        {
          "method": "POST",
          "path": "/payments"
        }
      ],
      "request": {
        "$ref": "#/components/schemas/CapturePayment"
      },
      "response": {
        "$ref": "#/components/schemas/PaymentDto"
      }
    },
    {
      "topic": "payments:get-all",
      "httpMappings": [
        {
          "method": "GET",
          "path": "/payments"
        }
      ],
      "request": { },
      "response": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/PaymentDto"
        }
      }
    }
  ],
  "events": [
    {
      "topic": "payment:captured",
      "message": {
        "$ref": "#/components/schemas/OutboundPaymentCaptured"
      }
    }
  ],
  "sends": [
    {
      "topic": "shipping:book",
      "request": {
        "$ref": "#/components/schemas/OutboundShipmentBook"
      }
    }
  ],
  "components": {
    "schemas": {
      "CapturePayment": {
        "required": [
          "amount",
          "currency",
          "orderId"
        ],
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "description": "Not Empty"
          },
          "amount": {
            "type": "number",
            "description": "Greater Than 0",
            "format": "double"
          },
          "currency": {
            "type": "string",
            "description": "Not Empty"
          }
        }
      },
      "OutboundPaymentCaptured": {
        "required": [
          "amount",
          "currency",
          "orderId",
          "paymentId"
        ],
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string"
          },
          "paymentId": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "format": "double"
          },
          "currency": {
            "type": "string"
          }
        }
      },
      "OutboundShipmentBook": {
        "required": [
          "carrier",
          "orderId"
        ],
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string"
          },
          "carrier": {
            "type": "string"
          }
        }
      },
      "PaymentDto": {
        "required": [
          "amount",
          "currency",
          "id",
          "orderId",
          "status"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "orderId": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "format": "double"
          },
          "currency": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      }
    }
  }
}