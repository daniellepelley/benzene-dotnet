<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <ItemGroup>
    <!-- The examples reference Benzene by ProjectReference, and analyzer assets do not flow along a
         ProjectReference chain the way they flow through a NuGet dependency. A user who installs
         Benzene.Core.MessageHandlers gets BENZ001/BENZ002; without this line the examples — the code
         most likely to be copied — would be the one place in the world they don't apply.

         The templates need no equivalent: they reference Benzene by PackageReference, so they pick the
         analyzer up transitively. -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\src\Benzene.CodeGen.SourceGenerators\Benzene.CodeGen.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Shared default for any example that opts into <BenzeneEmitDescriptor>true</BenzeneEmitDescriptor>
         (see src/Benzene.Descriptor/build/Benzene.Descriptor.targets). This repo's CI builds
         Benzene.sln (where Benzene.Descriptor lives) and Benzene.Examples.sln (where the examples
         live) as separate GitHub Actions jobs with no shared filesystem state, so the packaged
         `benzene-descriptor` tool cannot be assumed to be on PATH when an example builds. Run it
         from source instead — `dotnet run` builds-then-runs it on demand, same-repo, no packaging or
         PATH dependency required. Anchored on $(MSBuildThisFileDirectory) rather than a per-project
         relative path so it stays correct no matter how deeply an opting-in example is nested. -->
    <BenzeneDescriptorCommand Condition="'$(BenzeneDescriptorCommand)' == ''">dotnet run --project "$(MSBuildThisFileDirectory)..\src\Benzene.Descriptor\Benzene.Descriptor.csproj" -c $(Configuration) --</BenzeneDescriptorCommand>
  </PropertyGroup>

</Project>
